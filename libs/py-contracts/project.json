{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "py-contracts",
  "projectType": "library",
  "sourceRoot": "libs/py-contracts/src",
  "tags": [
    "lang:py",
    "type:lib"
  ],
  "targets": {
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "uv run --frozen ruff check libs/py-contracts",
          "uv run --frozen ruff format --check libs/py-contracts"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen mypy --cache-dir .mypy_cache/py-contracts libs/py-contracts/src libs/py-contracts/tests",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen pytest libs/py-contracts/tests -o cache_dir=.pytest_cache/py-contracts --cov=onb_contracts --cov-report=term-missing --cov-fail-under=80",
        "cwd": ".",
        "env": {
          "COVERAGE_FILE": ".coverage.py-contracts"
        }
      }
    }
  }
}
