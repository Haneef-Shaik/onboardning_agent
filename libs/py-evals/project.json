{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "py-evals",
  "projectType": "library",
  "sourceRoot": "libs/py-evals/src",
  "tags": [
    "lang:py",
    "type:lib"
  ],
  "targets": {
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "uv run --frozen ruff check libs/py-evals",
          "uv run --frozen ruff format --check libs/py-evals"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen mypy --cache-dir .mypy_cache/py-evals libs/py-evals/src libs/py-evals/tests libs/py-evals/tests_int",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen pytest libs/py-evals/tests -o cache_dir=.pytest_cache/py-evals --cov=onb_evals --cov-report=term-missing --cov-fail-under=80",
        "cwd": ".",
        "env": {
          "COVERAGE_FILE": ".coverage.py-evals"
        }
      }
    },
    "test-int": {
      "executor": "@nxlv/python:run-commands",
      "cache": false,
      "options": {
        "command": "uv run --frozen pytest libs/py-evals/tests_int -o cache_dir=.pytest_cache/py-evals-int",
        "cwd": "."
      }
    }
  }
}
