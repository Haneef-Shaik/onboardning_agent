{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": [
    "lang:py",
    "type:app"
  ],
  "targets": {
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "uv run --frozen ruff check apps/api",
          "uv run --frozen ruff format --check apps/api"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen mypy --cache-dir .mypy_cache/api apps/api/src apps/api/tests apps/api/tests_int",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen pytest apps/api/tests -o cache_dir=.pytest_cache/api",
        "cwd": ".",
        "env": {
          "COVERAGE_FILE": ".coverage.api"
        }
      }
    },
    "test-int": {
      "executor": "@nxlv/python:run-commands",
      "cache": false,
      "options": {
        "command": "uv run --frozen pytest apps/api/tests_int -o cache_dir=.pytest_cache/api-int",
        "cwd": "."
      }
    }
  }
}
