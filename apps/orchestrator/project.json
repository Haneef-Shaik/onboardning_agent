{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "orchestrator",
  "projectType": "application",
  "sourceRoot": "apps/orchestrator/src",
  "tags": [
    "lang:py",
    "type:app"
  ],
  "targets": {
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "uv run --frozen ruff check apps/orchestrator",
          "uv run --frozen ruff format --check apps/orchestrator"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen mypy --cache-dir .mypy_cache/orchestrator apps/orchestrator/src apps/orchestrator/tests apps/orchestrator/tests_int",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen pytest apps/orchestrator/tests -o cache_dir=.pytest_cache/orchestrator",
        "cwd": ".",
        "env": {
          "COVERAGE_FILE": ".coverage.orchestrator"
        }
      }
    },
    "test-int": {
      "executor": "@nxlv/python:run-commands",
      "cache": false,
      "options": {
        "command": "uv run --frozen pytest apps/orchestrator/tests_int -o cache_dir=.pytest_cache/orchestrator-int",
        "cwd": "."
      }
    }
  }
}
