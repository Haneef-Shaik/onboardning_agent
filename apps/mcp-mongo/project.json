{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "mcp-mongo",
  "projectType": "application",
  "sourceRoot": "apps/mcp-mongo/src",
  "tags": [
    "lang:py",
    "type:app"
  ],
  "targets": {
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "uv run --frozen ruff check apps/mcp-mongo",
          "uv run --frozen ruff format --check apps/mcp-mongo"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen mypy --cache-dir .mypy_cache/mcp-mongo apps/mcp-mongo/src apps/mcp-mongo/tests apps/mcp-mongo/tests_int",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "command": "uv run --frozen pytest apps/mcp-mongo/tests -o cache_dir=.pytest_cache/mcp-mongo",
        "cwd": ".",
        "env": {
          "COVERAGE_FILE": ".coverage.mcp-mongo"
        }
      }
    },
    "test-int": {
      "executor": "@nxlv/python:run-commands",
      "cache": false,
      "options": {
        "command": "uv run --frozen pytest apps/mcp-mongo/tests_int -o cache_dir=.pytest_cache/mcp-mongo-int",
        "cwd": "."
      }
    }
  }
}
