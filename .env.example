# Local environment. Copy to `.env` (git-ignored, never committed) and fill in every empty value.
# Every variable used by infra/docker-compose.yml must be listed here: `make check` runs
# scripts/check_env_example.py to enforce it. Required values are checked again by compose at
# startup (`${VAR:?…}`), so `make up` refuses to start with one missing.
# The Makefile also sources this file with bash: single-quote any value with spaces or shell
# characters (`$ & ; ( )`).

# --- Compose: lets plain `docker compose …` work from the repo root (after `make up` has made the
# Mongo keyfile once). Running a second stack on this machine, e.g. from another git worktree? Give
# it its own COMPOSE_PROJECT_NAME and Caddy ports, or it takes over this one's containers and volumes.
COMPOSE_FILE=infra/docker-compose.yml
COMPOSE_PROJECT_NAME=onb
COMPOSE_PROFILES=dev

# --- Caddy, the only service that publishes ports
# Keep 127.0.0.1 with the dev Caddyfile; 0.0.0.0 belongs with the VM Caddyfile (deployment goal).
# Change the ports if 80/443 are taken locally.
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# The app behind https://localhost:<CADDY_HTTPS_PORT> (UI-1): Caddy sends /api/* to the API and the
# rest to the web dev server, both run on the host. Defaults: uvicorn on 8000, Vite on 5173.
# Docker Desktop reaches them on 127.0.0.1. Linux: bind them to the docker bridge address (WEB_HOST for
# Vite, `uvicorn --host`), never 0.0.0.0.
API_DEV_UPSTREAM=host.docker.internal:8000
WEB_DEV_UPSTREAM=host.docker.internal:5173

# Jaeger UI at https://jaeger.localhost:<CADDY_HTTPS_PORT> behind basic auth. Make the bcrypt hash with
#   docker run --rm caddy:2.11.9-alpine caddy hash-password --plaintext '<password>'
# and keep it in single quotes: it contains `$`.
JAEGER_BASIC_AUTH_USER=admin
JAEGER_BASIC_AUTH_HASH=

# --- MongoDB root user, created on the first start of an empty data volume
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# --- Seed data (`make seed`, PRD §7.11; config/seed.yaml names the users and their password variables)
# The database `make seed` (and the API on the host) uses. Leave MONGO_URI empty locally: `make seed`
# then reaches this stack's mongo through a short-lived loopback tunnel as the root user. Set it (e.g.
# through the VM's SSH tunnel) to seed another MongoDB.
MONGO_URI=
MONGO_DATABASE=onboarding
# Vault master key (PRD §7.10): base64 of 32 bytes, from `openssl rand -base64 32`. The seed creates the
# org's keys wrapped by it, so the API must run with the same value.
PII_MASTER_KEY=
# One password per variable, at least 12 characters (bcrypt reads at most 72 bytes). Only bcrypt hashes
# are stored. The seed never changes an existing user, so changing a value later changes nothing.
# `make seed` reads this file with bash: single-quote a password holding `$`, backticks, `#` or quotes.
SEED_HR_ADMIN_PASSWORD=
SEED_HR_PASSWORD=
SEED_MANAGER_PASSWORD=

# --- LLM connectors (PRD §7.1; config/llm.yaml reads these). Model ids live here, never in code.
# LLM_CONNECTOR switches every alias to another connector (`fake` for CI and eval self-tests);
# `make llm-health CONNECTOR=…` sets it for that run.
LLM_CONNECTOR=bedrock
# The three aliases need a model value even with LLM_CONNECTOR=fake (the fake model ignores it).
LLM_MODEL_FAST=
LLM_MODEL_STANDARD=
LLM_MODEL_DEEP=
# bedrock: AWS_REGION is required at startup. Credentials come from the standard AWS chain: set
# AWS_PROFILE, or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY (least-privileged; see OW-1).
AWS_REGION=
# Optional Bedrock Guardrail, additive to the platform's guardrails. Leave both empty for none.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# fake: optional JSON script every fake model replays (see libs/py-llm/src/onb_llm/connectors/script.py).
LLM_FAKE_SCRIPT_FILE=
